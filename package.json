{
  "name": "mercaso-master-catalog",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "web:dev": "pnpm build && pnpm --filter web dev",
    "web:build": "pnpm build && pnpm --filter web build",
    "athena:check": "tsx scripts/athena/run.ts check",
    "athena:export": "tsx scripts/athena/run.ts export",
    "crosscheck": "tsx scripts/crosscheck/run.ts",
    "match": "tsx scripts/match/run.ts",
    "gaps": "tsx scripts/match/gaps.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-athena": "^3.1143.0",
    "@aws-sdk/client-sts": "^3.1143.0",
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "csv-parse": "^7.0.3",
    "yaml": "^2.9.1"
  }
}
